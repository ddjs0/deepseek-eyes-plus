# 在 https://modelscope.cn 免费获取 API Key（每天500次）
# 登录 → 个人中心 → 访问令牌 → 创建令牌
MODELSCOPE_API_KEY=your_key_here

# 可选: 覆盖默认视觉模型
# 可选: Qwen/Qwen3-VL-235B-A22B-Instruct（更强） / Qwen/Qwen3-VL-8B-Instruct（默认）
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 可选: 覆盖 API Base（OpenAI 兼容端点，支持图片/音频/视频）
# 小米 MiMo 全模态示例（mimo-v2.5 原生支持图像/视频/音频/文本）:
#   VISION_API_BASE=https://api.xiaomimimo.com/v1
#   VISION_MODEL=mimo-v2.5
#   MODELSCOPE_API_KEY=sk-xxx   # 小米开放平台 key（platform.xiaomimimo.com）
# VISION_API_BASE=https://api-inference.modelscope.cn/v1

# deepseek-eyes 配置示例（本文件只是参考，程序不读取 .env，配置需写入 MCP 客户端的 env 块）

# 视觉模型平台的 API Key（必填）
# 默认平台 ModelScope：https://modelscope.cn 免费获取（每天500次）
#   - ModelScope 的 key 形如 ms-xxxxxxxxxxxx，ms- 前缀会自动去除，无需手动处理
# 其他平台（小米 mimo / 智谱 / OpenAI / Claude 等）的 key 写法见 docs/VISION_MODELS.md
VISION_API_KEY=your_key_here

# 兼容旧名：MODELSCOPE_API_KEY 仍可用（与 VISION_API_KEY 等价，VISION_API_KEY 优先）
# MODELSCOPE_API_KEY=your_key_here

# 可选: 覆盖默认视觉模型
# 可选: Qwen/Qwen3-VL-235B-A22B-Instruct（更强） / Qwen/Qwen3-VL-8B-Instruct（默认）
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 可选: 覆盖 API Base（OpenAI 兼容端点，支持图片/音频/视频）
# 小米 MiMo 全模态示例（mimo-v2.5 原生支持图像/视频/音频/文本）:
#   VISION_API_BASE=https://api.xiaomimimo.com/v1
#   VISION_MODEL=mimo-v2.5
#   VISION_API_KEY=sk-xxx   # 小米开放平台 key（platform.xiaomimimo.com）
# VISION_API_BASE=https://api-inference.modelscope.cn/v1
